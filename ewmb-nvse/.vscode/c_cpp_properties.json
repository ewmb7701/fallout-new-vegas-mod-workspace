{
  "version": 4,
  "configurations": [
    {
      "name": "xNVSE Win32 Debug",
      "includePath": [
        "${workspaceFolder}",
        "${workspaceFolder}\\source",
        "${workspaceFolder}\\source\\nvse"
      ],
      "defines": [
        "WIN32",
        "_DEBUG",
        "_WINDOWS",
        "_USRDLL",
        "EWMB_NVSE_EXPORTS",
        "RUNTIME",
        "RUNTIME_VERSION=0x040020D0"
      ],
      "forcedInclude": ["${workspaceFolder}\\source\\prefix.h"],
      "windowsSdkVersion": "10.0.0",
      "intelliSenseMode": "windows-msvc-x86",
      "cppStandard": "c++20",
      "cStandard": "c17"
    }
  ]
}
