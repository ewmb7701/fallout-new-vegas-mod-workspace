                <file source="mods\ContentBartonTheWastelandTechSalvager\Config\ActorValuePatcher\JSawyerContentBartonTheWastelandTechSalvager.ini" destination="Config\ActorValuePatcher\JSawyerContentBartonTheWastelandTechSalvager.ini" priority="0" />
