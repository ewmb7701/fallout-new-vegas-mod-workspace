<?xml version='1.0' encoding='utf-8'?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://qconsulting.ca/fo3/ModConfig5.0.xsd">
  <moduleName>JSawyerless</moduleName>
  <installSteps order="Explicit">
    <installStep name="Installed Mods">
      <optionalFileGroups order="Explicit">
        <group name="" type="SelectAny">
          <plugins order="Explicit">
            <plugin name="YUP">
              <description>Select whether YUP is installed. Fixes fully covered by YUP are unavailable when YUP is installed. Other fixes always install their base changes and automatically include their NoYUP addon only without YUP.</description>
              <conditionFlags>
                <flag name="InstalledYUP">On</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
            <plugin name="STARS">
              <description>Select whether STARS is installed. STARS balance is required when Unique Armors content is selected.</description>
              <conditionFlags>
                <flag name="InstalledSTARS">On</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
            <plugin name="SPARE">
              <description>Select whether SPARE is installed. SPARE balance is required when Junk Rounds content is selected; JSawyer Junk Rounds balance is unavailable.</description>
              <conditionFlags>
                <flag name="InstalledSPARE">On</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
          </plugins>
        </group>
      </optionalFileGroups>
    </installStep>
    <installStep name="Content">
      <optionalFileGroups order="Explicit">
        <group name="" type="SelectAny">
          <plugins order="Explicit">
            <plugin name="Barton the Wasteland Tech Salvager">
